# O instalar.sh cria o .env sozinho, com senhas aleatórias. Este arquivo é só referência.
# O arquivo .env NUNCA vai para o GitHub.
DOMINIO=seudominio.com
PORTAL_URL=https://seudominio.com
DB_PRODUCAO_SENHA=gerada-automaticamente
DB_TESTE_SENHA=gerada-automaticamente
APP_PRODUCAO_SENHA=gerada-automaticamente
APP_TESTE_SENHA=gerada-automaticamente
# WhatsApp por QR Code (o atualizar.sh cria estas sozinho se faltarem)
WHATSAPP_API_KEY=gerada-automaticamente
WHATSAPP_DB_SENHA=gerada-automaticamente
WHATSAPP_WEBHOOK_SEGREDO=gerada-automaticamente

# Pedidos da Shopee / Mercado Livre ao vivo (docs/PEDIDOS-AO-VIVO.md). Segredos: openssl rand -hex 24
MARKETPLACE_WEBHOOK_SEGREDO=
MARKETPLACE_WEBHOOK_SEGREDO_TESTE=
ML_APP_ID=
ML_USER_ID=
ML_ACCESS_TOKEN=
SHOPEE_PARTNER_KEY=
SHOPEE_SHOP_ID=
