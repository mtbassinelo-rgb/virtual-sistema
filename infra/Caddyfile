# Caddy emite e renova os certificados HTTPS sozinho.

# Equipe (produção)
app.{$DOMINIO} {
	# Canal ao vivo da área do estoquista (SSE): sem compressão e sem segurar no buffer
	@aovivo path /api/estoque/ao-vivo
	handle @aovivo {
		reverse_proxy vc-app-producao:3000 {
			flush_interval -1
		}
	}
	handle {
		encode gzip
		reverse_proxy vc-app-producao:3000
	}
}

# Ambiente de teste
teste.{$DOMINIO} {
	# Canal ao vivo da área do estoquista (SSE): sem compressão e sem segurar no buffer
	@aovivo path /api/estoque/ao-vivo
	handle @aovivo {
		reverse_proxy vc-app-teste:3000 {
			flush_interval -1
		}
	}
	handle {
		encode gzip
		reverse_proxy vc-app-teste:3000
	}
}

# www vai sempre para o endereço sem www: um endereço só, para o cliente não "sair" ao trocar de um para o outro
www.{$DOMINIO} {
	redir https://{$DOMINIO}{uri} permanent
}

# Domínio principal: área do cliente (atacado). O resto vai para o endereço da equipe.
{$DOMINIO} {
	encode gzip
	@raiz path /
	redir @raiz /loja
	# Site da loja de Ciudad del Este (mesmos produtos, estoque da loja)
	@cde path /cde /cde/
	redir @cde /loja/cde
	@cliente path /loja /loja/* /_next/* /marca/* /fotos/* /icon.png /favicon.ico /robots.txt /sitemap.xml
	handle @cliente {
		reverse_proxy vc-app-producao:3000
	}
	handle {
		redir https://app.{$DOMINIO}{uri}
	}
}

# Outros sistemas na mesma VPS (ex.: Instituto Supremo). Cada um grava seu arquivo em /opt/caddy-extra.
import /etc/caddy/extra/*.caddy
